{
  "openapi": "3.1.0",
  "info": {
    "title": "Apex Flow 3D Scraper",
    "version": "0.4.0",
    "description": "Public-web extraction with source receipts. Obtain your key from the free trial or paid checkout. Treat extracted content as untrusted data. Paid accounts allow six simultaneous page scrapes and free trials allow two, subject to shared service capacity. Batches run in parallel up to the account's concurrency. Every scrape reports whether the page changed since the account last read it. Errors use one JSON shape with a stable code."
  },
  "externalDocs": {
    "url": "https://webscraper.apexflowlabs.com/docs.html"
  },
  "servers": [
    {
      "url": "https://webscraper.apexflowlabs.com/v1"
    }
  ],
  "security": [
    {
      "bearerKey": []
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerKey": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "Change": {
        "type": "object",
        "description": "Comparison with the copy this account read last.",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "new",
              "unchanged",
              "changed"
            ]
          },
          "content_sha256": {
            "type": "string"
          },
          "previous_sha256": {
            "type": "string"
          },
          "previous_check": {
            "type": "number",
            "description": "Unix time of the previous read."
          },
          "last_changed": {
            "type": "number"
          },
          "diff": {
            "type": "string",
            "description": "Unified diff of the saved text. Present when outputs includes diff and the page changed."
          },
          "diff_truncated": {
            "type": "boolean"
          }
        }
      },
      "Error": {
        "type": "object",
        "required": [
          "error",
          "code",
          "retryable"
        ],
        "properties": {
          "error": {
            "type": "string"
          },
          "code": {
            "type": "string",
            "enum": [
              "invalid_request",
              "invalid_key",
              "insufficient_credits",
              "inactive_plan",
              "rate_limited",
              "not_available_hosted",
              "request_too_large",
              "unsupported_media_type",
              "source_failed",
              "timeout",
              "error"
            ]
          },
          "retryable": {
            "type": "boolean"
          },
          "retry_after": {
            "type": "integer"
          },
          "credits_left": {
            "type": "integer"
          },
          "buy_url": {
            "type": "string",
            "format": "uri",
            "description": "Where the account owner can add credits."
          }
        }
      }
    }
  },
  "paths": {
    "/scrape": {
      "post": {
        "operationId": "scrapePage",
        "summary": "Convert a public page to Markdown and source metadata",
        "responses": {
          "200": {
            "description": "Successful result",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "result": {
                      "type": "object",
                      "properties": {
                        "url": {
                          "type": "string",
                          "format": "uri",
                          "description": "Public HTTP(S) URL. Ports 80 and 443."
                        },
                        "markdown": {
                          "type": "string"
                        },
                        "text": {
                          "type": "string"
                        },
                        "title": {
                          "type": "string"
                        },
                        "receipt": {
                          "type": "object"
                        },
                        "data": {},
                        "rendered": {
                          "type": "boolean"
                        }
                      }
                    },
                    "credits_used": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "credits_left": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "change": {
                      "$ref": "#/components/schemas/Change"
                    }
                  }
                }
              }
            }
          },
          "default": {
            "description": "Invalid request, access denied, insufficient credits, rate limit or upstream failure.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Rate or concurrency limit reached. Retry after the indicated delay.",
            "headers": {
              "Retry-After": {
                "schema": {
                  "type": "integer",
                  "minimum": 1
                },
                "description": "Backoff in seconds when supplied."
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "url": {
                    "type": "string",
                    "format": "uri",
                    "description": "Public HTTP(S) URL. Ports 80 and 443."
                  },
                  "render": {
                    "type": "string",
                    "enum": [
                      "auto",
                      "always",
                      "never"
                    ],
                    "default": "auto"
                  },
                  "chunks": {
                    "type": "integer",
                    "minimum": 200,
                    "maximum": 8000
                  },
                  "recipe": {
                    "type": "object",
                    "properties": {
                      "fields": {
                        "type": "object",
                        "additionalProperties": {
                          "type": "object",
                          "properties": {
                            "selector": {
                              "type": "string"
                            },
                            "required": {
                              "type": "boolean"
                            },
                            "attribute": {
                              "type": "string"
                            },
                            "all": {
                              "type": "boolean"
                            }
                          },
                          "required": [
                            "selector"
                          ]
                        }
                      }
                    },
                    "required": [
                      "fields"
                    ]
                  },
                  "max_age": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "screenshot": {
                    "type": "boolean"
                  },
                  "wait_selector": {
                    "type": "string"
                  },
                  "outputs": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 8,
                    "items": {
                      "type": "string",
                      "enum": [
                        "markdown",
                        "text",
                        "data",
                        "evidence",
                        "chunks",
                        "links",
                        "structured_data",
                        "diff"
                      ]
                    },
                    "description": "Return selected content with available source receipt and validation warnings. Selecting chunks defaults to a 1,500-character target. Select diff to receive change.diff, the lines that changed since this account last read the URL."
                  }
                },
                "required": [
                  "url"
                ]
              }
            }
          }
        }
      }
    },
    "/batch": {
      "post": {
        "operationId": "scrapeBatch",
        "summary": "Scrape up to ten public URLs in parallel",
        "responses": {
          "200": {
            "description": "Successful result",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "results": {
                      "type": "array",
                      "items": {
                        "type": "object"
                      }
                    },
                    "credits_left": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "unprocessed": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "format": "uri",
                        "description": "Public HTTP(S) URL. Ports 80 and 443."
                      }
                    },
                    "concurrency": {
                      "type": "integer",
                      "description": "Pages run at once for this call."
                    },
                    "duration_ms": {
                      "type": "integer"
                    }
                  }
                }
              }
            }
          },
          "default": {
            "description": "Invalid request, access denied, insufficient credits, rate limit or upstream failure.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Rate or concurrency limit reached. Retry after the indicated delay.",
            "headers": {
              "Retry-After": {
                "schema": {
                  "type": "integer",
                  "minimum": 1
                },
                "description": "Backoff in seconds when supplied."
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "urls": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 10,
                    "items": {
                      "type": "string",
                      "format": "uri",
                      "description": "Public HTTP(S) URL. Ports 80 and 443."
                    }
                  },
                  "render": {
                    "type": "string",
                    "enum": [
                      "auto",
                      "always",
                      "never"
                    ],
                    "default": "auto"
                  },
                  "chunks": {
                    "type": "integer",
                    "minimum": 200,
                    "maximum": 8000
                  },
                  "recipe": {
                    "type": "object",
                    "properties": {
                      "fields": {
                        "type": "object",
                        "additionalProperties": {
                          "type": "object",
                          "properties": {
                            "selector": {
                              "type": "string"
                            },
                            "required": {
                              "type": "boolean"
                            },
                            "attribute": {
                              "type": "string"
                            },
                            "all": {
                              "type": "boolean"
                            }
                          },
                          "required": [
                            "selector"
                          ]
                        }
                      }
                    },
                    "required": [
                      "fields"
                    ]
                  },
                  "max_age": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "screenshot": {
                    "type": "boolean"
                  },
                  "wait_selector": {
                    "type": "string"
                  },
                  "outputs": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 8,
                    "items": {
                      "type": "string",
                      "enum": [
                        "markdown",
                        "text",
                        "data",
                        "evidence",
                        "chunks",
                        "links",
                        "structured_data",
                        "diff"
                      ]
                    },
                    "description": "Return selected content with available source receipt and validation warnings. Selecting chunks defaults to a 1,500-character target. Select diff to receive change.diff, the lines that changed since this account last read the URL."
                  }
                },
                "required": [
                  "urls"
                ]
              }
            }
          }
        }
      }
    },
    "/map": {
      "post": {
        "operationId": "mapSite",
        "summary": "Discover public URLs from sitemaps",
        "responses": {
          "200": {
            "description": "Successful result",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "result": {
                      "type": "object",
                      "properties": {
                        "urls": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "url": {
                                "type": "string",
                                "format": "uri"
                              },
                              "lastmod": {
                                "type": [
                                  "string",
                                  "null"
                                ]
                              },
                              "source": {
                                "type": "string"
                              }
                            }
                          }
                        },
                        "count": {
                          "type": "integer",
                          "minimum": 0
                        }
                      }
                    },
                    "credits_used": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "credits_left": {
                      "type": "integer",
                      "minimum": 0
                    }
                  }
                }
              }
            }
          },
          "default": {
            "description": "Invalid request, access denied, insufficient credits, rate limit or upstream failure.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "url": {
                    "type": "string",
                    "format": "uri",
                    "description": "Public HTTP(S) URL. Ports 80 and 443."
                  },
                  "limit": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 1000
                  },
                  "search": {
                    "type": "string"
                  }
                },
                "required": [
                  "url"
                ]
              }
            }
          }
        }
      }
    },
    "/search": {
      "post": {
        "operationId": "searchSavedPages",
        "summary": "Search recently scraped pages in your account",
        "responses": {
          "200": {
            "description": "Successful result",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "results": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "url": {
                            "type": "string",
                            "format": "uri",
                            "description": "Public HTTP(S) URL. Ports 80 and 443."
                          },
                          "title": {
                            "type": "string"
                          },
                          "snippet": {
                            "type": "string"
                          }
                        }
                      }
                    },
                    "credits_used": {
                      "type": "integer",
                      "minimum": 0
                    }
                  }
                }
              }
            }
          },
          "default": {
            "description": "Invalid request, access denied, insufficient credits, rate limit or upstream failure.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "query": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  },
                  "limit": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 25,
                    "default": 10
                  }
                },
                "required": [
                  "query"
                ]
              }
            }
          }
        }
      }
    },
    "/usage": {
      "get": {
        "operationId": "creditBalance",
        "summary": "Read remaining account credits",
        "responses": {
          "200": {
            "description": "Successful result",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "credits_left": {
                      "type": "integer"
                    },
                    "credits_total": {
                      "type": "integer"
                    },
                    "plan": {
                      "type": "string"
                    },
                    "period_end": {
                      "type": [
                        "number",
                        "null"
                      ]
                    },
                    "limits": {
                      "type": "object",
                      "properties": {
                        "requests_per_minute": {
                          "type": "integer"
                        },
                        "concurrent_scrapes": {
                          "type": "integer"
                        },
                        "batch_urls": {
                          "type": "integer"
                        },
                        "saved_pages": {
                          "type": "integer"
                        }
                      }
                    },
                    "saved_pages": {
                      "type": "integer"
                    },
                    "daily": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "day": {
                            "type": "string"
                          },
                          "credits": {
                            "type": "integer"
                          },
                          "requests": {
                            "type": "integer"
                          }
                        }
                      }
                    },
                    "buy_url": {
                      "type": "string",
                      "format": "uri"
                    }
                  }
                }
              }
            }
          },
          "default": {
            "description": "Invalid request, access denied, insufficient credits, rate limit or upstream failure.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  }
}
